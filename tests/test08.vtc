varnishtest "probe with base_url"

barrier b1 cond 2

server s1 {
	# hold the first probe until c1 has seen the backend sick
	rxreq
	expect req.url == "/probe"
	barrier b1 sync
	txresp
	accept

	# probes and /req, in whatever order they come (-break stops this
	# loop once we need the probes to fail)
	loop 100 {
		rxreq
		expect req.url ~ "^/(probe|req)$"
		txresp
		accept
	}
} -start

# VCL, no backend needed
varnish v1 -arg "-p debug=+syncvsl" -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.window = 4;
		.initial = 1;
		.threshold = 3;
		.interval = 1s;
	}

	backend s1 none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s1_addr}:${s1_port}", probe = p1);
	}

	sub vcl_recv {
		set req.backend_hint = client.backend();
	}
} -start

# -d 1: read from the head of the log, the first probe runs at warm
logexpect l1 -v v1 -g raw -d 1 {
	expect * 0 Backend_health "^client Went healthy "
} -start

client c1 {
	# initial = 1 of threshold 3: two more good probes are needed, and
	# the first probe is held by s1
	txreq -url "/req"
	rxresp
	expect resp.status == 503
	barrier b1 sync
} -run

logexpect l1 -wait

client c1 {
	txreq -url "/req"
	rxresp
	expect resp.status == 200
} -run

logexpect l2 -v v1 -g raw {
	expect * 0 Backend_health "^client Went sick .* Error: expected 200 status, got 404$"
} -start

# restart s1 on the same port, failing every probe: two failures take
# the backend from 4/4 to 2/4
server s1 -break
server s1 -listen "${s1_sock}" {
	loop 100 {
		rxreq
		expect req.url == "/probe"
		txresp -status 404
		accept
	}
} -start

logexpect l2 -wait

logexpect l3 -v v1 -g raw {
	expect * * FetchError "^reqwest: unhealthy$"
} -start

client c1 {
	txreq -url "/req2"
	rxresp
	expect resp.status == 503
} -run

logexpect l3 -wait
