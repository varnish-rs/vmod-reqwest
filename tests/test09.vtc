varnishtest "backend.list"

feature cmd "jq"

server s1 {
	loop 255 {
		rxreq
		expect req.url == "/probe"
		txresp
		close
		accept
	}
} -start

# VCL, no backend needed
varnish v1 -arg "-p debug=+syncvsl" -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.window = 4;
		.initial = 1;
		.threshold = 3;
		.interval = 1s;
	}

	backend s1 none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s1_addr}:${s1_port}", probe = p1);
		new client2 = reqwest.client(base_url = "http://${s1_addr}:${s1_port}");
	}
} -start

# -d 1: read from the head of the log, the first probe runs at warm
logexpect l1 -v v1 -g raw -d 1 {
	expect * 0 Backend_health "^client Went healthy "
} -start

logexpect l1 -wait

shell {
	set -e
	varnishadm -n ${v1_name} backend.list -j -p | jq -e '
		.[3]["vcl1.client"] |
		.admin_health == "probe" and
		.probe_message[0] >= 3 and
		.probe_message[1] == 4 and
		.probe_message[2] == "healthy" and
		.probe_details.request.Url == "/probe" and
		.probe_details.interval.secs == 1 and
		.probe_details.exp_status == 200 and
		.probe_details.window == 4 and
		.probe_details.threshold == 3 and
		.probe_details.initial == 1'
	varnishadm -n ${v1_name} backend.list -j -p | jq -e '
		.[3]["vcl1.client2"] |
		.admin_health == "healthy" and .probe_message == []'
	varnishadm -n ${v1_name} backend.list -j | jq -e '
		.[3] | keys == ["vcl1.client", "vcl1.client2"] and
		(map(has("probe_details")) | any | not)'
}

varnish v1 -cliexpect {vcl1\.client +probe +[34]/4\s+healthy } "backend.list"
varnish v1 -cliexpect "vcl1\\.client2 +healthy " "backend.list"
varnish v1 -cliexpect "Current states  good: +[34] threshold: +3 window: +4" "backend.list -p"
