varnishtest "probe inherits accept_invalid HTTPS settings"

feature tls

server s1 {
    # probe fires immediately after vcl_init
    tls_handshake
    rxreq
    expect req.url == "/probe"
    txresp
    close
    accept

    # regular client request forwarded through the reqwest client
    tls_handshake
    rxreq
    expect req.url == "/"
    txresp
} -start

varnish v1 -arg "-p debug=+syncvsl" -vcl {
    import reqwest from "${vmod}";

    probe p1 {
        .url = "/probe";
        .window = 1;
        .initial = 0;
        .threshold = 1;
        .interval = 60s;
    }

    backend default none;

    sub vcl_init {
        new client = reqwest.client(
            base_url = "https://${s1_addr}:${s1_port}",
            accept_invalid_certs = true,
            accept_invalid_hostnames = true,
            probe = p1
        );
    }

    sub vcl_recv {
        set req.backend_hint = client.backend();
    }
} -start

# -d 1: read from the head of the log, the first probe runs at warm;
# the next one is 60s away, so s1 sees the client request first
logexpect l1 -v v1 -g raw -d 1 {
    expect * 0 Backend_health "^client Went healthy "
} -start

logexpect l1 -wait

client c1 {
    txreq
    rxresp
    expect resp.status == 200
} -run

server s1 -wait
