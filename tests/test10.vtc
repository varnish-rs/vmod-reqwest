varnishtest "probe with full .url"

barrier b1 cond 2

server s1 {
	rxreq
	expect req.url == "/url2"
	txresp
} -start

server s2 {
	# hold the first probe until c1 has seen the backend sick
	rxreq
	expect req.url == "/probe"
	barrier b1 sync
	txresp
	close
	accept

	loop 100 {
		rxreq
		expect req.url == "/probe"
		txresp
		close
		accept
	}
} -start

# VCL, no backend needed
varnish v1 -arg "-p debug=+syncvsl" -vcl {
	import reqwest from "${vmod}";

	# because .url is a full URL, p1 is tied to s2
	probe p1 {
		.url = "http://${s2_addr}:${s2_port}/probe";
		.window = 4;
		.initial = 2;
		.threshold = 4;
		.interval = 1s;
	}

	backend s1 none;

	sub vcl_init {
		new client = reqwest.client(probe = p1);
	}

	sub vcl_recv {
		# this client will hit s1, but only if s2 is responding to probes
		set req.backend_hint = client.backend();
		set req.http.host = "${s1_addr}:${s1_port}";
	}
} -start

# -d 1: read from the head of the log, the first probe runs at warm
logexpect l1 -v v1 -g raw -d 1 {
	expect * 0 Backend_health "^client Went healthy "
} -start

client c1 {
	# 2 good probes of 4 needed, and the first probe is held by s2
	txreq -url "/url1"
	rxresp
	expect resp.status == 503
	barrier b1 sync
} -run

logexpect l1 -wait

client c1 {
	txreq -url "/url2"
	rxresp
	expect resp.status == 200
} -run
