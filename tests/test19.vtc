varnishtest "Probed reqwest clients survive VCL warm/cold/discard churn"

# Smoke test only: the race this exercises (a probe task touching freed
# state after Cold + discard) has a microsecond window and can't be hit
# reliably from a VTC. The structural guard is the unit test in backend.rs.

# Timings: a VCL's probe task starts on its Warm event (during vcl.load,
# or at child start for vcl1)
# and its first request sits in s0 for 1s. Each cycle below goes cold and
# discards the previous VCL right after loading the next one (a few hundred
# ms), well inside that 1s, so the first probe is still in flight. Should a
# slow vcl.load overrun it, the probe loop only sleeps 0.1s between 1s
# requests, so a probe is still in flight ~90% of the time.
server s0 {
	rxreq
	expect req.url == "/probe"
	delay 1
	txresp
} -dispatch

varnish v1 -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.timeout = 2s;
		.interval = 0.1s;
	}

	backend default none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s0_addr}:${s0_port}", probe = p1);
	}
} -start

varnish v1 -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.timeout = 2s;
		.interval = 0.1s;
	}

	backend default none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s0_addr}:${s0_port}", probe = p1);
	}
}

varnish v1 -cliok "vcl.state vcl1 cold"
varnish v1 -cliok "vcl.discard vcl1"

varnish v1 -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.timeout = 2s;
		.interval = 0.1s;
	}

	backend default none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s0_addr}:${s0_port}", probe = p1);
	}
}

varnish v1 -cliok "vcl.state vcl2 cold"
varnish v1 -cliok "vcl.discard vcl2"

varnish v1 -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.timeout = 2s;
		.interval = 0.1s;
	}

	backend default none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s0_addr}:${s0_port}", probe = p1);
	}
}

varnish v1 -cliok "vcl.state vcl3 cold"
varnish v1 -cliok "vcl.discard vcl3"

# Give an aborted probe task that kept running time to crash the child
# before checking for a panic.
delay 1.2

varnish v1 -cliok "vcl.list"
varnish v1 -expect MGT.child_panic == 0
