varnish v1 -cliok "vcl.state vcl4 cold"
varnish v1 -cliok "vcl.discard vcl4"

delay 1.2

varnish v1 -vcl {
	import reqwest from "${vmod}";

	probe p1 {
		.url = "/probe";
		.timeout = 2s;
		.interval = 1s;
	}

	backend default none;

	sub vcl_init {
		new client = reqwest.client(base_url = "http://${s0_addr}:${s0_port}", probe = p1);
	}
}

varnish v1 -cliok "vcl.state vcl5 cold"
varnish v1 -cliok "vcl.discard vcl5"

delay 1.2

varnish v1 -cliok "vcl.list"
varnish v1 -expect MGT.child_panic == 0
